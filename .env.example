# Configuração da API Backend
# Use URL relativa para desenvolvimento (funciona com proxy do Vite)
# Use URL completa para produção: http://localhost:8080
VITE_API_URL=/

# Dados estáticos (mock) ficam ligados por padrão para permitir testar a
# interface sem o backend rodando. Descomente a linha abaixo quando o
# backend estiver disponível e você quiser usar dados reais.
# VITE_USE_MOCK=false

