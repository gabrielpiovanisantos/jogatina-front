server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS interno do Docker/Podman (detectado automaticamente pelo entrypoint
    # da imagem via NGINX_ENTRYPOINT_LOCAL_RESOLVERS). Resolver em tempo de
    # requisição (via variável) evita que o container crashe se o backend
    # ainda não estiver no ar ou na rede.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
    set $backend_url "${BACKEND_URL}";

    # Arquivos estáticos com hash no nome (Vite) podem ser cacheados agressivamente
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Proxy para o backend, igual ao proxy do Vite em desenvolvimento.
    # O backend já mapeia os controllers com o prefixo /api e /dashboard,
    # então repassamos a URI original sem reescrever (proxy_pass sem path
    # quando o destino é uma variável encaminha $request_uri como veio).
    location /api/ {
        proxy_pass $backend_url;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /dashboard/ {
        proxy_pass $backend_url;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: qualquer rota desconhecida cai no index.html (React Router/estado do app)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
